{
  "manifest_version": 3,
  "name": "100mini Pomodoro — Focus Timer",
  "version": "1.0.0",
  "description": "Pomodoro focus timer with growing tomato animation, customizable breaks, and cloud sync. Boost productivity and stay motivated.",
  "homepage_url": "https://100mini.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "100mini Pomodoro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://100mini.com/*"
  ]
}
